# ============================================================
# EasyRyde Secure Environment Configuration
# ============================================================
# Copy this file to .env (for your environment) and fill in
# ALL values marked CHANGE_ME. NEVER commit the real .env file.
#
# To generate secrets:
#   APP_KEY:       php artisan key:generate --show
#   JWT_SECRET:    openssl rand -hex 32
#   DB_PASSWORD:   openssl rand -base64 32
#   REDIS_PASSWORD: openssl rand -base64 32
#
# ============================================================

# --- Application ---
APP_NAME=EasyRyde
APP_ENV=local                              # local | production | testing
APP_KEY=CHANGE_ME                          # php artisan key:generate --show
APP_DEBUG=true                             # false in production
APP_URL=http://localhost:8000

# Webhook IP validation bypass (NEVER enable in production, only for local dev)
APP_WEBHOOK_BYPASS=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_PREVIOUS_KEYS=
BCRYPT_ROUNDS=12

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=easyryde
DB_USERNAME=easyryde
DB_PASSWORD=CHANGE_ME                      # openssl rand -base64 32

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME                   # openssl rand -base64 32
REDIS_URL=redis://redis:6379

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache ---
CACHE_STORE=redis

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Logging ---
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Sentry ---
SENTRY_DSN=CHANGE_ME                       # Get from https://sentry.io
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.25

# --- Mail (SendGrid) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=CHANGE_ME                    # SendGrid API key
MAIL_FROM_ADDRESS=noreply@easyryde.co.za
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe ---
STRIPE_SECRET_KEY=CHANGE_ME                # sk_live_...
STRIPE_PUBLISHABLE_KEY=CHANGE_ME           # pk_live_...
STRIPE_WEBHOOK_SECRET=CHANGE_ME            # whsec_...

# --- PayFast ---
PAYFAST_MERCHANT_ID=CHANGE_ME
PAYFAST_MERCHANT_KEY=CHANGE_ME
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# --- Ozow ---
OZOW_SITE_CODE=CHANGE_ME
OZOW_API_KEY=CHANGE_ME
OZOW_PRIVATE_KEY=CHANGE_ME

# --- Twilio (SMS) ---
TWILIO_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=CHANGE_ME

# --- Firebase / FCM ---
FCM_PROJECT_ID=easyryde-625a7
FCM_SERVICE_ACCOUNT_PATH=storage/firebase-service-account.json

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:3000
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=er_

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Socket.IO ---
JWT_SECRET=CHANGE_ME                       # openssl rand -hex 32

# --- Mobile Apps (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME  # Google Cloud Console

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
