# ============================================================
# EasyRyde Production Environment Configuration
# ============================================================
# Copy this to .env and fill in ALL values marked CHANGE_ME
# NEVER commit the actual .env file to version control
# ============================================================

# --- Application ---
APP_NAME=EasyRyde
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.easyryde.co.za
APP_KEY=CHANGE_ME                    # Generate: php artisan key:generate --show
APP_PREVIOUS_KEYS=
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (PostgreSQL with PostGIS) ---
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=easyryde
DB_USERNAME=easyryde
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_USERNAME=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=easyryde_

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache ---
CACHE_STORE=redis
CACHE_PREFIX=easyryde_cache_

# --- Queue ---
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# --- Broadcasting ---
BROADCAST_CONNECTION=redis

# --- Filesystem ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=api.easyryde.co.za
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=er_

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://api.easyryde.co.za

# --- Horizon ---
HORIZON_PATH=horizon

# --- Logging / Monitoring ---
SENTRY_DSN=CHANGE_ME                # Get from https://sentry.io
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.25
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Mail (SendGrid) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=CHANGE_ME             # SendGrid API key
MAIL_FROM_ADDRESS="noreply@easyryde.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe ---
STRIPE_SECRET_KEY=CHANGE_ME         # sk_live_...
STRIPE_PUBLISHABLE_KEY=CHANGE_ME    # pk_live_...
STRIPE_WEBHOOK_SECRET=CHANGE_ME     # whsec_...

# --- PayFast ---
PAYFAST_MERCHANT_ID=CHANGE_ME
PAYFAST_MERCHANT_KEY=CHANGE_ME
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false
PAYFAST_RETURN_URL=https://api.easyryde.co.za/payments/payfast/return
PAYFAST_CANCEL_URL=https://api.easyryde.co.za/payments/payfast/cancel
PAYFAST_NOTIFY_URL=https://api.easyryde.co.za/api/v1/payments/payfast/webhook

# --- Ozow ---
OZOW_SITE_CODE=CHANGE_ME
OZOW_API_KEY=CHANGE_ME
OZOW_PRIVATE_KEY=CHANGE_ME
OZOW_SANDBOX=false
OZOW_COUNTRY_CODE=ZA
OZOW_CURRENCY_CODE=ZAR
OZOW_NOTIFY_URL=https://api.easyryde.co.za/api/v1/payments/ozow/webhook
OZOW_RETURN_URL=https://api.easyryde.co.za/payments/ozow/return
OZOW_CANCEL_URL=https://api.easyryde.co.za/payments/ozow/cancel

# --- Firebase / FCM ---
FCM_PROJECT_ID=easyryde-625a7
FCM_SERVICE_ACCOUNT_PATH=storage/firebase-service-account.json

# --- Twilio (SMS) ---
TWILIO_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=CHANGE_ME

# --- Socket.IO ---
JWT_SECRET=CHANGE_ME                # Generate: openssl rand -hex 32
CLIENT_URL=https://api.easyryde.co.za
STALE_LOCATION_TTL=300
CLEANUP_INTERVAL_MS=60000
DRIVER_RADIUS_KM=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- PHBIMH Integration (Phalaborwa in My Hand) ---
PHBIMH_BASE_URL=https://phbimh.co.za/api
PHBIMH_API_KEY=
PHBIMH_WEBHOOK_SECRET=

# --- Mobile Apps (Expo) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_API_URL=https://api.easyryde.co.za
EXPO_PUBLIC_SOCKET_URL=https://socket.easyryde.co.za

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
